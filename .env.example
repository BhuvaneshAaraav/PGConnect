# Local development uses the replica set initialized by docker-compose.
MONGODB_URI=mongodb://localhost:27017/pgconnect?replicaSet=rs0
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Cloud photo storage (S3 or compatible; use an IAM role or standard AWS credentials).
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Razorpay test keys for backend order creation and signed payment callbacks/webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Provision an administrator only on the first run with these values. Do not reuse a resident/owner email.
PGCONNECT_ADMIN_EMAIL=
PGCONNECT_ADMIN_PASSWORD=

# Optional Google geocoding key. Public place/radius search uses this provider.
GOOGLE_MAPS_API_KEY=

# Resend account links for email verification and password reset.
EMAIL_RESEND_API_KEY=
EMAIL_FROM=PGConnect <accounts@example.com>
EMAIL_WEB_ORIGIN=http://localhost:3000

# Google Identity Services web OAuth client ID (also set as VITE_GOOGLE_CLIENT_ID in frontend/.env.local).
GOOGLE_OAUTH_CLIENT_ID=

# Owner platform fee is monthly and separate from resident rent.
OWNER_SUBSCRIPTION_MONTHLY_RUPEES=1000
OWNER_SUBSCRIPTION_GRACE_DAYS=3
